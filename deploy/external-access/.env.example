# Copy to .env. This file contains NO token, private key or device credential.
# One DNS name, without https://, path or port. A/AAAA must reach this VPS.
VARIN_DOMAIN=varin.example.com
# Public TCP control port; container still listens on 7000. Match Varin's frps port.
FRP_CONTROL_PORT=7000
# Optional control bind IP on the VPS, not the private application mapping.
FRP_CONTROL_BIND_IP=0.0.0.0
# Application mapping 7300 is fixed in frps.toml and Caddyfile and NOT published.
