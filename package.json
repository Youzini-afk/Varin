{
  "name": "varin-monorepo",
  "version": "0.9.22",
  "description": "An independent agent workspace and harness for coding and research, with a bundled Pi runtime.",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.3.14",
  "workspaces": [
    "packages/*"
  ],
  "engines": {
    "node": ">=22.0.0"
  },
  "keywords": [
    "pi",
    "coding-agent",
    "ai",
    "coding",
    "varin",
    "cli"
  ],
  "author": "Youzini-afk and Varin contributors",
  "license": "AGPL-3.0-only",
  "scripts": {
    "dev": "node ./scripts/dev-web-hmr.mjs",
    "varin-dev": "node scripts/varin-dev.mjs",
    "build": "bun run build:type-dependencies && bun run --sequential --filter '!@varin/mobile' build && bun run --cwd packages/mobile build:assets",
    "build:web": "bun run --cwd packages/extension-loader build && bun run --cwd packages/runtime-client build && bun run --cwd packages/web build",
    "build:cloud-runtime": "node scripts/build-cloud-runtime.mjs",
    "update:cloud-runtime-lock": "node scripts/build-cloud-runtime.mjs --skip-build --no-archive --update-lock",
    "build:ui": "bun run --cwd packages/ui build",
    "build:monaco-smoke": "bun run --cwd packages/web build:monaco-smoke",
    "build:electron": "bun run --cwd packages/electron build",
    "build:mobile": "bun run --cwd packages/mobile build",
    "build:type-dependencies": "bun run --cwd packages/settings-store build && bun run --cwd packages/runtime-broker build && bun run --cwd packages/runtime-client build && bun run --cwd packages/extension-contract build && bun run --cwd packages/application-client build && bun run --cwd packages/extension-host build && bun run --cwd packages/extension-loader build && bun run --cwd packages/web build:application-host:types",
    "type-check": "bun run build:type-dependencies && bun run --filter '@varin/*' type-check",
    "type-check:web": "bun run --cwd packages/web type-check",
    "type-check:ui": "bun run --cwd packages/ui type-check",
    "type-check:electron": "bun run --cwd packages/electron prepare:type-check && bun run --cwd packages/electron type-check",
    "type-check:mobile": "bun run --cwd packages/mobile type-check",
    "lint": "bun run --filter '@varin/*' lint",
    "lint:web": "bun run --cwd packages/web lint",
    "lint:ui": "bun run --cwd packages/ui lint",
    "lint:electron": "bun run --cwd packages/electron lint",
    "lint:mobile": "bun run --cwd packages/mobile lint",
    "audit:dependencies": "node scripts/audit-dependencies.mjs",
    "clean": "bun run --filter '*' clean",
    "changelog-card": "node scripts/changelog-card/generate.mjs",
    "branding:generate": "bun run scripts/generate-product-brand-assets.ts && bun run --cwd packages/mobile branding:generate",
    "postinstall": "node ./scripts/fix-deprecation.js && node ./packages/electron/scripts/ensure-electron.mjs --best-effort",
    "test:pi": "bun run --sequential --no-exit-on-error --filter '@varin/*' test",
    "test:pi:dist": "bun run --sequential --no-exit-on-error --filter '@varin/*' test:dist",
    "test:node-smoke": "bun run --cwd packages/web test:node-smoke",
    "kernel:build": "node scripts/build-kernel.mjs",
    "kernel:check": "cargo check --manifest-path kernel/Cargo.toml",
    "test:kernel": "node scripts/test-kernel-authority.mjs",
    "kernel:protocol": "node scripts/generate-kernel-protocol.mjs",
    "check:pi": "bun run build:type-dependencies && bun run --filter '@varin/*' type-check && bun run test:pi",
    "test:cloud": "bunx vitest run scripts/cloud-runtime-layout.test.js",
    "dev:web": "bun run --cwd packages/web build:watch",
    "dev:web:server": "bun run --cwd packages/web dev:server:watch",
    "dev:web:full": "node ./scripts/dev-web-full.mjs",
    "dev:web:hmr": "node ./scripts/dev-web-hmr.mjs",
    "start:web": "bun run --cwd packages/web start",
    "pack:web": "bun run --cwd packages/web build && bun pm pack --cwd packages/web",
    "electron:dev": "node ./packages/electron/scripts/electron-dev.mjs",
    "electron:dev:bundled": "VARIN_ELECTRON_USE_BUNDLED_UI=1 node ./packages/electron/scripts/electron-dev.mjs",
    "electron:build": "bun run --cwd packages/electron package",
    "electron:build:win": "bun run --cwd packages/electron package:win:x64",
    "electron:build:monaco-smoke:win": "cross-env VARIN_MONACO_SMOKE=1 bun run electron:build:win",
    "electron:smoke:win": "bun run --cwd packages/electron smoke:win:unpacked",
    "electron:smoke:monaco:win": "cross-env VARIN_MONACO_SMOKE=1 bun run electron:smoke:win",
    "mobile:build": "bun run --cwd packages/mobile build",
    "mobile:sync": "bun run --cwd packages/mobile sync",
    "mobile:add:ios": "bun run --cwd packages/mobile add:ios",
    "mobile:add:android": "bun run --cwd packages/mobile add:android",
    "mobile:build:android:debug": "bun run --cwd packages/mobile build:android:debug",
    "mobile:build:ios:simulator": "bun run --cwd packages/mobile build:ios:simulator",
    "mobile:sim:boot": "bun run --cwd packages/mobile sim:boot",
    "mobile:sim:install": "bun run --cwd packages/mobile sim:install",
    "mobile:sim:launch": "bun run --cwd packages/mobile sim:launch",
    "mobile:sim:run": "bun run --cwd packages/mobile sim:run",
    "mobile:sim:dev": "bun run --cwd packages/mobile sim:dev",
    "mobile:sim:serve": "bun run --cwd packages/mobile sim:serve",
    "mobile:sim:list": "bun run --cwd packages/mobile sim:list",
    "mobile:sim:kill": "bun run --cwd packages/mobile sim:kill",
    "mobile:open:ios": "bun run --cwd packages/mobile open:ios",
    "mobile:open:android": "bun run --cwd packages/mobile open:android",
    "mobile:dev": "bun run --cwd packages/mobile dev",
    "mobile:ios": "bun run --cwd packages/mobile ios",
    "mobile:android": "bun run --cwd packages/mobile android",
    "mobile:prebuild": "bun run --cwd packages/mobile prebuild",
    "splash:emit": "bun run scripts/splash/emit-splash.ts",
    "docs:validate": "node scripts/docs/validate-docs.mjs",
    "test:docs": "node --test scripts/docs/engineering-docs.test.mjs",
    "harness:replay": "node scripts/harness-replay.mjs",
    "test:harness-replay": "node --test scripts/harness-replay.test.mjs",
    "test:i18n": "bun run --cwd packages/ui test:i18n",
    "dead-code": "bunx knip@5.80.0 --no-exit-code --include files,exports,nsExports,types,nsTypes,enumMembers,duplicates",
    "profile:browser": "node scripts/profile-browser.mjs",
    "icons:sprite": "node scripts/generate-file-type-sprite.mjs",
    "themes:port:opencode": "tsx scripts/port-opencode-theme.ts",
    "version:bump": "node scripts/bump-version.mjs",
    "release:prepare": "bun run build && bun run type-check && bun run lint",
    "release:npm:prepare": "node scripts/npm-public-release.mjs prepare",
    "release:npm:verify": "node scripts/npm-public-release.mjs verify",
    "release:npm:test": "node --test scripts/npm-public-release.test.mjs && bun run --cwd packages/extension-contract test && bun run --cwd packages/extension-surface test && bun run --cwd packages/extension-sdk test && bun run --cwd packages/extension-cli test && bun run --cwd packages/application-client test",
    "release:npm:build": "bun run --cwd packages/extension-contract build && bun run --cwd packages/extension-surface build && bun run --cwd packages/extension-sdk build && bun run --cwd packages/extension-react build && bun run --cwd packages/extension-cli build && bun run --cwd packages/application-client build",
    "release:npm:package": "node scripts/npm-public-release.mjs package",
    "release:npm:publish": "node scripts/npm-public-release.mjs publish",
    "smoke:extension": "node scripts/smoke-extension.mjs"
  },
  "overrides": {
    "@humanfs/node": "0.16.8",
    "@xmldom/xmldom": "0.8.15",
    "@babel/core": "7.29.7",
    "@babel/plugin-transform-modules-systemjs": "7.29.8",
    "@peculiar/asn1-ecc": "2.9.5",
    "@peculiar/asn1-rsa": "2.9.5",
    "@peculiar/asn1-schema": "2.9.5",
    "@peculiar/asn1-x509": "2.9.5",
    "@codemirror/language": "6.12.4",
    "@codemirror/lint": "6.9.5",
    "@codemirror/state": "6.5.4",
    "@codemirror/view": "6.39.13",
    "@tootallnate/once": "2.0.1",
    "adm-zip": "0.6.1",
    "app-builder-lib": "26.15.7",
    "body-parser": "2.3.0",
    "browserslist": "4.28.7",
    "builder-util-runtime": "9.7.0",
    "dompurify": "3.4.16",
    "esbuild": "0.28.1",
    "fast-uri": "3.1.8",
    "flatted": "3.4.4",
    "follow-redirects": "1.16.0",
    "form-data": "4.0.6",
    "ip-address": "10.4.0",
    "js-yaml": "4.3.2",
    "linkify-it": "5.0.2",
    "lodash": "4.18.1",
    "markdown-it": "14.3.0",
    "multer": "2.4.0",
    "nanoid": "5.1.16",
    "node-abi": "4.33.0",
    "path-to-regexp": "8.4.2",
    "picomatch": "4.0.7",
    "postcss": "8.5.25",
    "protobufjs": "7.6.5",
    "qs": "6.16.0",
    "serialize-javascript": "7.0.7",
    "sharp": "0.35.4",
    "shell-quote": "1.10.0",
    "tar": "7.5.22",
    "tmp": "0.2.7",
    "uuid": "11.1.1",
    "vite": "8.3.0",
    "yaml": "2.9.0"
  },
  "devDependencies": {
    "@clack/prompts": "^1.7.0",
    "@eslint/js": "^10.0.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/dom-speech-recognition": "^0.0.12",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.1.1",
    "autoprefixer": "^10.5.4",
    "babel-plugin-react-compiler": "^1.0.0",
    "concurrently": "^10.0.4",
    "cors": "^2.8.6",
    "cross-env": "^10.1.0",
    "eslint": "^10.11.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.6",
    "globals": "^17.12.0",
    "node-addon-api": "7.1.1",
    "nodemon": "^3.1.14",
    "sharp": "^0.35.4",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.1",
    "tw-animate-css": "^1.4.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.70.1",
    "typescript-language-server": "^5.3.0",
    "vite": "^8.3.0",
    "vitest": "^5.0.0"
  },
  "patchedDependencies": {
    "@earendil-works/pi-ai@1.0.0": "packages/pi-host/patches/@earendil-works%2Fpi-ai@1.0.0.patch",
    "@tanstack/virtual-core@3.17.3": "bun-patches/@tanstack+virtual-core+3.17.3.patch",
    "ghostty-web@0.4.0": "bun-patches/ghostty-web+0.4.0.patch",
    "@earendil-works/pi-agent-core@1.0.0": "packages/pi-host/patches/@earendil-works%2Fpi-agent-core@1.0.0.patch",
    "@earendil-works/pi-coding-agent@1.0.0": "packages/pi-host/patches/@earendil-works%2Fpi-coding-agent@1.0.0.patch",
    "app-builder-lib@26.15.7": "bun-patches/app-builder-lib@26.15.7.patch",
    "braces@3.0.3": "bun-patches/braces@3.0.3.patch",
    "http-cache-semantics@4.2.0": "bun-patches/http-cache-semantics@4.2.0.patch"
  }
}
