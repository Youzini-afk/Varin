{
  "name": "@varin/extension-contract",
  "version": "0.2.0",
  "license": "AGPL-3.0-only",
  "type": "module",
  "description": "Browser-safe contracts for Varin extensions and extension-host catalogs.",
  "files": [
    "dist",
    "schema"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./schema/manifest": "./schema/varin.extension.schema.json",
    "./schema/discovery": "./schema/varin.discovery-catalog.schema.json"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Youzini-afk/Varin.git",
    "directory": "packages/extension-contract"
  },
  "homepage": "https://github.com/Youzini-afk/Varin/tree/main/packages/extension-contract",
  "bugs": "https://github.com/Youzini-afk/Varin/issues",
  "publishConfig": {
    "access": "public"
  },
  "sideEffects": false,
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "lint": "eslint \"./src/**/*.ts\" --config ../../eslint.config.js",
    "test": "tsx --test \"test/**/*.test.ts\"",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "type-check": "tsc --noEmit -p tsconfig.json"
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "dependencies": {
    "semver": "^7.8.5"
  },
  "devDependencies": {
    "@types/semver": "^7.8.0",
    "ajv": "^8.20.0"
  }
}
