{
  "name": "@varin/pi-host",
  "version": "0.1.0",
  "license": "AGPL-3.0-only",
  "private": true,
  "type": "module",
  "description": "Isolated Node host for Varin's Pi SDK runtime.",
  "files": [
    "dist",
    "patches"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "varin-host": "./dist/host-bootstrap.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./discovery": {
      "types": "./dist/runtime-discovery.d.ts",
      "import": "./dist/runtime-discovery.js"
    },
    "./sdk": {
      "types": "./dist/pi-sdk-packages.d.ts",
      "import": "./dist/pi-sdk-packages.js"
    },
    "./credentials": {
      "types": "./dist/credential-authority.d.ts",
      "import": "./dist/credential-authority.js"
    },
    "./host": "./dist/host-bootstrap.js",
    "./tool-schema": {
      "types": "./dist/tool-schema.d.ts",
      "import": "./dist/tool-schema.js"
    },
    "./mcp-authority": {
      "types": "./dist/mcp-authority.d.ts",
      "import": "./dist/mcp-authority.js"
    }
  },
  "scripts": {
    "build": "bun run build:dependencies && tsc -p tsconfig.build.json",
    "build:dependencies": "bun run --cwd ../protocol build",
    "lint": "eslint \"./src/**/*.ts\" --config ../../eslint.config.js",
    "test": "tsx --test \"test/**/*.test.ts\"",
    "test:dist": "node --test test/dist-smoke.test.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "type-check": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@earendil-works/pi-agent-core": "1.0.4",
    "@earendil-works/pi-ai": "1.0.4",
    "@earendil-works/pi-mcp": "1.0.4",
    "@earendil-works/pi-coding-agent": "1.0.4",
    "@varin/protocol": "0.1.0",
    "jsonc-parser": "^3.3.1",
    "proper-lockfile": "4.1.2",
    "typebox": "1.3.36",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1"
  },
  "devDependencies": {
    "@types/proper-lockfile": "4.1.4"
  },
  "engines": {
    "node": ">=22.19.0"
  }
}
