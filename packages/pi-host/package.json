{
  "name": "@varin/pi-host",
  "version": "0.1.0",
  "license": "AGPL-3.0-only",
  "private": true,
  "type": "module",
  "description": "Isolated Node host for Varin's Pi SDK runtime.",
  "files": [
    "dist"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "varin-host": "./dist/host-bootstrap.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./discovery": {
      "types": "./dist/runtime-discovery.d.ts",
      "import": "./dist/runtime-discovery.js"
    },
    "./sdk": {
      "types": "./dist/pi-sdk-packages.d.ts",
      "import": "./dist/pi-sdk-packages.js"
    },
    "./host": "./dist/host-bootstrap.js"
  },
  "scripts": {
    "build": "bun run build:dependencies && tsc -p tsconfig.build.json",
    "build:dependencies": "bun run --cwd ../protocol build",
    "lint": "eslint \"./src/**/*.ts\" --config ../../eslint.config.js",
    "test": "tsx --test \"test/**/*.test.ts\"",
    "test:dist": "bun run build && node --test test/dist-smoke.test.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "type-check": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@earendil-works/pi-agent-core": "0.87.1",
    "@earendil-works/pi-ai": "0.87.1",
    "@earendil-works/pi-coding-agent": "0.87.1",
    "@varin/protocol": "0.1.0",
    "jsonc-parser": "^3.3.1",
    "proper-lockfile": "4.1.2",
    "typebox": "1.3.7"
  },
  "devDependencies": {
    "@types/proper-lockfile": "4.1.4"
  },
  "engines": {
    "node": ">=22.19.0"
  }
}
