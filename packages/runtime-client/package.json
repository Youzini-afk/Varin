{
  "name": "@varin/runtime-client",
  "version": "0.1.0",
  "license": "AGPL-3.0-only",
  "private": true,
  "type": "module",
  "description": "Browser-safe Varin runtime protocol client.",
  "files": [
    "dist"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "bun run --cwd ../protocol build && tsc -p tsconfig.build.json",
    "lint": "eslint \"./src/**/*.ts\" --config ../../eslint.config.js",
    "test": "tsx --test \"test/**/*.test.ts\"",
    "test:dist": "node --test test/dist-smoke.test.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "type-check": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@varin/protocol": "0.1.0"
  },
  "engines": {
    "node": ">=22.19.0"
  }
}
