{
  "name": "@varin/web",
  "version": "0.9.22",
  "license": "AGPL-3.0-only",
  "private": false,
  "type": "module",
  "main": "./server/index.js",
  "types": "./server/index.d.ts",
  "exports": {
    ".": {
      "types": "./server/index.d.ts",
      "default": "./server/index.js"
    },
    "./server/*": "./server/*",
    "./application-host/*": {
      "types": "./.application-host-types/*.d.ts",
      "default": "./server/*.js"
    }
  },
  "bin": {
    "varin": "./bin/cli.js"
  },
  "imports": {
    "#application-host/*": "./server/*"
  },
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "scripts": {
    "dev": "bun run build:watch",
    "dev:server": "bun run build:application-host && node server/index.js",
    "dev:server:watch": "bun run prepare:application-host && nodemon --exitcrash --watch application-host --ext js,ts --exec \"node scripts/run-application-host-dev.mjs\"",
    "prepare:application-host": "bun run --cwd ../application-client build && bun run --cwd ../runtime-broker build && bun run --cwd ../extension-host build",
    "build:application-host:raw": "node scripts/build-application-host.mjs",
    "build:application-host:types": "node scripts/build-application-host-types.mjs",
    "build:application-host": "bun run prepare:application-host && bun run build:application-host:raw",
    "build:kernel": "node ../../scripts/build-kernel.mjs --stage kernel",
    "build:cli:raw": "node scripts/build-cli.mjs",
    "build:cli": "bun run build:application-host && bun run build:cli:raw",
    "build": "bun run build:application-host && bun run build:kernel && bun run build:cli:raw && bun run --cwd ../extension-builtins build && vite build",
    "build:monaco-smoke": "cross-env VARIN_MONACO_SMOKE=1 VARIN_MONACO_BUNDLE_AUDIT=1 bun run build && node scripts/verify-monaco-bundle.mjs",
    "build:watch": "vite build --watch",
    "type-check": "bun run type-check:kernel-protocol && tsc --noEmit && bun run type-check:application-host && bun run type-check:cli:raw",
    "type-check:kernel-protocol": "node ../../scripts/generate-kernel-protocol.mjs --check",
    "type-check:application-host:tests": "tsc --noEmit -p tsconfig.application-host.tests.json",
    "type-check:application-host:raw": "bun run build:application-host:types && bun run type-check:application-host:tests",
    "type-check:application-host": "bun run prepare:application-host && bun run type-check:application-host:raw",
    "type-check:cli:source": "tsc --noEmit -p tsconfig.cli.json",
    "type-check:cli:tests": "tsc --noEmit -p tsconfig.cli.tests.json",
    "type-check:cli:raw": "bun run type-check:cli:source && bun run type-check:cli:tests",
    "lint": "eslint \"./src/**/*.{ts,tsx}\" \"./application-host/**/*.ts\" \"./cli/**/*.ts\" --config ../../eslint.config.js",
    "test": "vitest run",
    "structure:cold-start": "tsx scripts/structure-cold-start.ts",
    "symbol-graph-query": "tsx scripts/symbol-graph-query.ts",
    "explore:observe": "tsx scripts/explore-observe.ts",
    "structure:copy-runtime": "node scripts/copy-structure-runtime.mjs",
    "semantic:copy-model": "node scripts/copy-semantic-model.mjs",
    "semantic:perf:scan": "tsx scripts/semantic-scan-perf.ts",
    "semantic:perf:store": "tsx scripts/semantic-store-perf.ts",
    "structure:refresh-grammar-manifest": "node ../../scripts/refresh-grammar-manifest.mjs",
    "test:node-smoke": "bun run build:application-host && node --test application-host/lib/knowledge/store.smoke.test.ts",
    "prepare:pi-runtime": "bun run prepare:application-host",
    "start": "bun run build:cli && node bin/cli.js serve",
    "clean": "node scripts/build-application-host.mjs --clean && node scripts/build-cli.mjs --clean"
  },
  "dependencies": {
    "@clack/prompts": "^1.1.0",
    "@konbakuyomu/smart-search": "^0.1.17",
    "@mozilla/readability": "0.6.0",
    "@napi-rs/canvas": "0.1.100",
    "@octokit/rest": "^22.0.1",
    "@simplewebauthn/server": "14.0.2",
    "@varin/application-client": "workspace:*",
    "@varin/extension-builtins": "workspace:*",
    "@varin/extension-contract": "workspace:*",
    "@varin/extension-host": "workspace:*",
    "@varin/protocol": "workspace:*",
    "@varin/runtime-broker": "workspace:*",
    "@varin/settings-store": "workspace:*",
    "adm-zip": "^0.6.1",
    "compression": "^1.8.1",
    "cron-parser": "^4.9.0",
    "diff": "9.0.0",
    "express": "^5.1.0",
    "http-proxy-middleware": "^4.2.0",
    "ignore": "7.0.5",
    "jose": "^6.2.12",
    "jsonc-parser": "^3.3.1",
    "linkedom": "0.18.13",
    "luxon": "^3.5.0",
    "multer": "^2.4.0",
    "openai": "^7.18.0",
    "pdfjs-dist": "4.10.38",
    "picomatch": "4.0.7",
    "qrcode-terminal": "^0.12.0",
    "reflect-metadata": "^0.2.2",
    "ripgrep": "^0.3.1",
    "sherpa-onnx-node": "1.13.8",
    "simple-git": "^3.28.0",
    "tar": "^7.5.13",
    "triviumdb": "0.8.8",
    "turndown": "7.2.4",
    "undici": "7.29.1",
    "web-push": "^3.6.7",
    "web-tree-sitter": "^0.27.0",
    "ws": "^8.18.3",
    "yaml": "^2.8.1",
    "yazl": "^3.3.1"
  },
  "devDependencies": {
    "@huggingface/transformers": "4.2.0",
    "@types/better-sqlite3": "^9.6.0",
    "@types/compression": "^1.8.1",
    "@types/express": "^5.0.0",
    "@types/luxon": "^3.7.5",
    "@types/multer": "^2.2.0",
    "@types/node": "^24.3.1",
    "@types/picomatch": "^4.0.3",
    "@types/qrcode-terminal": "^0.12.2",
    "@types/react": "^19.1.10",
    "@types/react-dom": "^19.1.7",
    "@types/supertest": "^7.2.1",
    "@types/turndown": "5.0.6",
    "@types/web-push": "^3.6.4",
    "@types/ws": "^8.18.1",
    "@types/yazl": "^3.3.1",
    "@varin/runtime-client": "workspace:*",
    "@varin/ui": "workspace:*",
    "@vitejs/plugin-react": "^6.1.1",
    "better-sqlite3": "^13.0.3",
    "eslint": "^10.11.0",
    "nodemon": "^3.1.7",
    "supertest": "^7.2.2",
    "tree-sitter-javascript": "0.25.0",
    "tree-sitter-json": "0.24.8",
    "tree-sitter-typescript": "0.23.2",
    "tsx": "^4.20.6",
    "typescript": "~5.9.0",
    "vite": "^8.3.0",
    "vite-plugin-pwa": "^1.0.3",
    "vitest": "^5.0.3",
    "workbox-window": "^7.4.1"
  },
  "files": [
    "dist",
    "server",
    "bin",
    "public",
    "kernel",
    "LICENSE",
    "THIRD_PARTY_NOTICES.md",
    "package.json",
    "README.md"
  ]
}
