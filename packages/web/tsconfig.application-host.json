{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "allowJs": false,
    "rootDir": "application-host",
    "outDir": ".application-host-build",
    "types": ["node"],
    "sourceMap": true,
    "declaration": true,
    "declarationMap": true,
    "noEmit": false,
    "lib": ["ES2023"],
    "paths": {
      "@varin/extension-contract": ["./node_modules/@varin/extension-contract/dist/index.d.ts"],
      "@varin/extension-contract/*": ["./node_modules/@varin/extension-contract/*"],
      "@varin/protocol": ["./node_modules/@varin/protocol/dist/index.d.ts"],
      "@varin/application-client": ["./node_modules/@varin/application-client/dist/index.d.ts"],
      "@varin/settings-store": ["./node_modules/@varin/settings-store/dist/index.d.ts"],
      "@varin/extension-host": ["./node_modules/@varin/extension-host/dist/index.d.ts"],
      "@varin/extension-loader": ["./node_modules/@varin/extension-loader/dist/index.d.ts"],
      "@varin/extension-builtins": ["./node_modules/@varin/extension-builtins/dist/index.d.ts"]
    }
  },
  "include": ["application-host/**/*.ts"],
  "exclude": ["application-host/**/*.test.ts"]
}
