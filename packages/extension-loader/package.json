{
  "name": "@varin/extension-loader",
  "version": "0.1.0",
  "license": "AGPL-3.0-only",
  "private": true,
  "type": "module",
  "description": "Authenticated managed Surface module loader for Varin extensions.",
  "files": ["dist"],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build:dependencies": "bun run --cwd ../extension-contract build && bun run --cwd ../extension-surface build && bun run --cwd ../extension-sdk build",
    "build": "bun run build:dependencies && bun run build:raw",
    "build:raw": "tsc -p tsconfig.build.json",
    "lint": "eslint \"./src/**/*.ts\" --config ../../eslint.config.js",
    "test": "node --import tsx --test \"test/**/*.test.ts\"",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "type-check": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@varin/extension-contract": "workspace:*",
    "@varin/extension-sdk": "workspace:*",
    "@varin/extension-surface": "workspace:*"
  },
  "engines": { "node": ">=22.19.0" }
}
