{
  "name": "@varin/extension-cli",
  "version": "0.2.0",
  "license": "AGPL-3.0-only",
  "type": "module",
  "description": "Author tooling for building and testing Varin extensions.",
  "files": [
    "dist"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Youzini-afk/Varin.git",
    "directory": "packages/extension-cli"
  },
  "homepage": "https://github.com/Youzini-afk/Varin/tree/main/packages/extension-cli",
  "bugs": "https://github.com/Youzini-afk/Varin/issues",
  "publishConfig": {
    "access": "public"
  },
  "sideEffects": false,
  "bin": {
    "varin-extension": "./dist/cli.js"
  },
  "scripts": {
    "build:dependencies": "bun run --cwd ../extension-sdk build",
    "build": "bun run build:dependencies && tsc -p tsconfig.build.json",
    "lint": "eslint \"./src/**/*.ts\" --config ../../eslint.config.js",
    "test": "tsx --test \"test/**/*.test.ts\"",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "type-check": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@clack/prompts": "^1.8.1",
    "@varin/extension-contract": "0.2.0",
    "@varin/extension-sdk": "0.2.0",
    "@varin/extension-surface": "0.2.0",
    "esbuild": "^0.28.2"
  },
  "engines": {
    "node": ">=22.19.0"
  }
}
