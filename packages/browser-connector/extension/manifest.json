{
  "manifest_version": 3,
  "name": "Varin Browser Connector",
  "version": "0.9.46",
  "minimum_chrome_version": "125",
  "description": "Explicitly share selected Chrome or Edge tabs with your paired Varin Host.",
  "permissions": ["activeTab", "debugger", "nativeMessaging", "storage"],
  "background": {"service_worker": "background.mjs", "type": "module"},
  "action": {"default_title": "Share this tab with Varin", "default_popup": "popup.html"},
  "incognito": "not_allowed",
  "content_security_policy": {"extension_pages": "script-src 'self'; object-src 'none'"}
}
