{
  "schemaVersion": 1,
  "id": "example.child-integration-tool",
  "displayName": "Fixed Child Result Integration",
  "version": "2.0.0",
  "engines": { "varin": "*" },
  "entrypoints": { "host": { "file": "host.cjs", "mode": "brokered", "activation": ["service-request"] } },
  "capabilities": { "host": ["collaboration.integrations"] },
  "provides": {
    "services": [{
      "id": "example.child-integration.apply",
      "version": 2,
      "tool": {
        "name": "integrate_child",
        "description": "Explicitly integrate a published isolated child's fixed file result into this parent Thread's physical source. Supply the original child operation, exact execution and publication identities returned by child_status. Uses the existing three-way merge and conditional file/Document writes; preserves conflicts and reports actual effects. It does not select a newer child result, write back to a fixed read-only source, or roll back conversation history.",
        "completion": "result",
        "operation": "effect",
        "inputSchema": {
          "type": "object",
          "properties": {
            "childOperationId": { "type": "string", "minLength": 1, "pattern": "\\S" },
            "executionId": { "type": "string", "minLength": 1, "pattern": "\\S" },
            "publicationId": { "type": "string", "minLength": 1, "pattern": "\\S" }
          },
          "required": ["childOperationId", "executionId", "publicationId"],
          "additionalProperties": false
        },
        "outputSchema": {
          "type": "object",
          "properties": {
            "status": { "enum": ["applied", "conflict", "compensated", "needs-attention", "rejected"] },
            "operationId": { "type": "string" },
            "effect": { "enum": ["none", "confirmed", "partial", "unknown"] },
            "executorStopped": { "type": "boolean" },
            "recoveryCoverage": { "const": "files-only" },
            "error": { "type": "string" }
          },
          "required": ["status"],
          "additionalProperties": true
        },
        "source": { "path": "host.ts", "line": 6 }
      }
    }]
  }
}
