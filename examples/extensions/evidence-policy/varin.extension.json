{
  "schemaVersion": 1,
  "id": "example.evidence-policy",
  "displayName": "Bounded Evidence Policy",
  "version": "2.0.0",
  "engines": {
    "varin": "*"
  },
  "entrypoints": {
    "host": {
      "file": "host.cjs",
      "mode": "brokered",
      "activation": [
        "service-request"
      ]
    }
  },
  "provides": {
    "services": [
      {
        "id": "varin.agent.policy",
        "version": 2,
        "multiple": true
      }
    ]
  }
}
