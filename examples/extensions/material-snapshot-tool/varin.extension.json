{
  "schemaVersion": 1,
  "id": "example.material-snapshot-tool",
  "displayName": "Stored Material Snapshot Reader",
  "version": "1.0.0",
  "engines": { "varin": "*" },
  "entrypoints": { "host": { "file": "host.cjs", "mode": "brokered", "activation": ["service-request"] } },
  "capabilities": { "host": ["materials.snapshot"] },
  "provides": {
    "services": [{
      "id": "example.material-snapshot.read",
      "version": 1,
      "tool": {
        "name": "material_snapshot_read",
        "description": "Read a UTF-8 page from an existing immutable material snapshot visible to this Thread. Use the returned nextOffset to continue and contentHash as expectedContentHash to pin the revision. This reads stored text only; it does not fetch URLs, parse documents, or run OCR.",
        "completion": "result",
        "operation": "read",
        "inputSchema": {
          "type": "object",
          "properties": {
            "snapshotId": { "type": "string", "minLength": 1, "pattern": "\\S" },
            "offset": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 },
            "maxBytes": { "type": "integer", "minimum": 1, "maximum": 9007199254740991 },
            "expectedContentHash": { "type": "string", "pattern": "^sha256-[0-9a-f]{64}$" }
          },
          "required": ["snapshotId", "offset", "maxBytes"],
          "additionalProperties": false
        },
        "outputSchema": {
          "oneOf": [
            {
              "type": "object",
              "properties": {
                "status": { "enum": ["ok", "empty"] },
                "snapshotId": { "type": "string" },
                "revision": { "type": "string" },
                "contentHash": { "type": "string" },
                "totalBytes": { "type": "integer", "minimum": 0 },
                "range": {
                  "type": "object",
                  "properties": { "offset": { "type": "integer", "minimum": 0 }, "byteLength": { "type": "integer", "minimum": 0 } },
                  "required": ["offset", "byteLength"],
                  "additionalProperties": false
                },
                "nextOffset": { "type": ["integer", "null"], "minimum": 0 },
                "text": { "type": "string" }
              },
              "required": ["status", "snapshotId", "revision", "contentHash", "totalBytes", "range", "nextOffset", "text"],
              "additionalProperties": false
            },
            {
              "type": "object",
              "properties": {
                "status": { "enum": ["unavailable", "conflict", "invalid-range", "corrupt"] },
                "snapshotId": { "type": "string" },
                "message": { "type": "string" }
              },
              "required": ["status", "snapshotId", "message"],
              "additionalProperties": false
            }
          ]
        },
        "examples": [{ "snapshotId": "snapshot-from-existing-material", "offset": 0, "maxBytes": 4096 }],
        "source": { "path": "host.ts", "line": 6 }
      }
    }]
  }
}
