{
  "name": "@varin/plugin-gmail",
  "version": "0.1.0",
  "type": "module",
  "license": "AGPL-3.0-only",
  "description": "Gmail with scoped Host credentials and one-action permissions.",
  "files": [
    "dist",
    "settings.css",
    "README.md",
    "varin.extension.json"
  ],
  "scripts": {
    "build": "varin-extension build .",
    "check": "varin-extension check .",
    "release": "varin-extension release .",
    "test": "node --import tsx --test *.test.ts"
  },
  "dependencies": {
    "@varin/extension-sdk": "0.2.0",
    "@varin/extension-contract": "0.2.0"
  },
  "devDependencies": {
    "@varin/extension-cli": "0.2.0",
    "tsx": "^4.23.15",
    "linkedom": "^0.18.14"
  },
  "varin": {
    "build": {
      "entrypoints": {
        "host": {
          "source": "host.ts"
        },
        "settings": {
          "source": "settings.ts"
        }
      }
    }
  },
  "engines": {
    "node": ">=22.19.0"
  }
}
