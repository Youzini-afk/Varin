{
  "schemaVersion": 1,
  "id": "example.model-protocol",
  "version": "1.0.0",
  "engines": {
    "varin": "*"
  },
  "displayName": "Example model protocol",
  "entrypoints": {
    "host": {
      "file": "host.cjs",
      "mode": "brokered",
      "activation": [
        "service-request"
      ]
    }
  },
  "provides": {
    "services": [
      {
        "id": "varin.models",
        "version": 1,
        "contract": {
          "methods": {
            "describe": {
              "inputSchema": {
                "type": "array",
                "maxItems": 0
              },
              "outputSchema": {
                "type": "object",
                "required": [
                  "channels",
                  "adapters",
                  "authentication"
                ],
                "additionalProperties": false,
                "properties": {
                  "channels": {
                    "type": "array",
                    "items": {
                      "type": "object"
                    }
                  },
                  "adapters": {
                    "type": "array",
                    "items": {
                      "type": "object"
                    }
                  },
                  "authentication": {
                    "type": "array",
                    "items": {
                      "type": "object"
                    }
                  }
                }
              }
            },
            "protocol": {
              "inputSchema": {
                "type": "array",
                "minItems": 1,
                "maxItems": 1,
                "items": {
                  "type": "object"
                }
              },
              "outputSchema": {
                "type": "object"
              }
            },
            "authenticate": {
              "inputSchema": {
                "type": "array",
                "minItems": 1,
                "maxItems": 1,
                "items": {
                  "type": "object"
                }
              },
              "outputSchema": {
                "type": "object"
              }
            }
          },
          "composition": "ordered"
        },
        "multiple": true
      }
    ]
  }
}
