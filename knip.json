{
  "$schema": "https://unpkg.com/knip@latest/schema.json",
  "workspaces": {
    ".": {
      "entry": [
        "scripts/**/*.{js,cjs,mjs,ts}"
      ],
      "project": [
        "*.{js,cjs,mjs,ts}",
        "scripts/**/*.{js,cjs,mjs,ts}"
      ]
    },
    "packages/ui": {
      "entry": [
        "src/apps/renderMobileApp.tsx",
        "src/apps/renderElectronMiniChatApp.tsx",
        "src/lib/monaco/fixture.ts",
        "src/**/*.{test,spec}.{js,cjs,mjs,jsx,ts,tsx}",
        "src/**/__tests__/**/*.{js,cjs,mjs,jsx,ts,tsx}"
      ],
      "project": [
        "src/**/*.{ts,tsx}"
      ]
    },
    "packages/web": {
      "entry": [
        "postcss.config.js",
        "src/main.tsx",
        "src/mobile-main.tsx",
        "src/mini-chat-main.tsx",
        "src/monaco-smoke.ts",
        "src/sw.ts",
        "server/**/*.{test,spec}.{js,cjs,mjs}",
        "src/**/*.{test,spec}.{ts,tsx}"
      ],
      "project": [
        "bin/**/*.js",
        "server/**/*.{js,mjs,cjs}",
        "src/**/*.{ts,tsx}"
      ]
    },
    "packages/electron": {
      "entry": [
        "main.mjs",
        "preload.mjs",
        "tray.mjs",
        "ssh-manager.mjs",
        "*.{test,spec}.{js,cjs,mjs}",
        "scripts/**/*.{js,cjs,mjs}"
      ],
      "project": [
        "*.{js,cjs,mjs}",
        "scripts/**/*.{js,cjs,mjs}"
      ]
    },
    "packages/pi-host": {
      "entry": [
        "src/index.ts",
        "src/main.ts",
        "src/host-bootstrap.ts",
        "src/pi-sdk-resolver.ts",
        "test/**/*.{test,spec}.{ts,mjs}"
      ],
      "project": [
        "src/**/*.ts",
        "test/**/*.{ts,mjs}"
      ]
    },
    "packages/runtime-broker": {
      "entry": [
        "src/index.ts",
        "src/core.ts",
        "test/**/*.{test,spec}.{ts,mjs}"
      ],
      "project": [
        "src/**/*.ts",
        "test/**/*.{ts,mjs}"
      ]
    },
    "packages/extension-builtins": {
      "entry": [
        "src/index.ts",
        "src/host.ts",
        "src/host/typescript-language-extension.ts",
        "scripts/**/*.mjs"
      ],
      "project": [
        "src/**/*.ts",
        "scripts/**/*.mjs"
      ]
    },
    "packages/mobile": {
      "entry": [
        "scripts/**/*.mjs"
      ],
      "project": [
        "scripts/**/*.mjs"
      ]
    }
  }
}
