{
  "compilerOptions": {
    "target": "ES2023",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "baseUrl": ".",
    "paths": {
      "@varin/extension-contract": [
        "packages/extension-contract/src/index.ts"
      ],
      "@varin/extension-builtins": [
        "packages/extension-builtins/src/index.ts"
      ],
      "@varin/extension-host": [
        "packages/extension-host/src/index.ts"
      ],
      "@varin/extension-loader": [
        "packages/extension-loader/src/index.ts"
      ],
      "@varin/extension-react": [
        "packages/extension-react/src/index.ts"
      ],
      "@varin/extension-sdk": [
        "packages/extension-sdk/src/index.ts"
      ],
      "@varin/extension-surface": [
        "packages/extension-surface/src/index.ts"
      ],
      "@varin/protocol": [
        "packages/protocol/src/index.ts"
      ],
      "@varin/protocol/node/embeddings": [
        "packages/protocol/src/node/embeddings.ts"
      ]
    },
    "lib": [
      "ES2023"
    ],
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "noUncheckedSideEffectImports": true,
    "verbatimModuleSyntax": true,
    "isolatedModules": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true
  }
}
